root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,csproj,wixproj,wxs,manifest,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
indent_style = tab
