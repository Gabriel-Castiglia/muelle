<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The setup window shown by muelle-setup.exe: a WiX 5 bootstrapper application. It runs on the
    .NET Framework 4.7.2 that ships with Windows 10 (version 1803 and later) and Windows 11, so the
    setup needs no runtime of its own.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>MuelleSetup</AssemblyName>
    <RootNamespace>Muelle.Setup</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>..\..\src\Muelle\muelle.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Muelle</Product>
    <Description>Muelle setup</Description>
    <!-- Same version as the app, read from the only place where it is set: src\Muelle\Muelle.csproj. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\src\Muelle\Muelle.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <Authors>Gabriel Castiglia</Authors>
    <Company>Gabriel Castiglia</Company>
    <Copyright>Copyright (C) 2026 Gabriel Castiglia</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Debug data names source files from the repository root (/_/), not from the folder where it was built. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same interface texts helper as the dock. -->
    <Compile Include="..\..\src\Muelle\Loc.cs" Link="Loc.cs" />
    <Resource Include="..\..\src\Muelle\muelle.ico" Link="muelle.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>

</Project>
