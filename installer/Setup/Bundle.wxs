<!--
  muelle-setup.exe: a WiX bundle that installs the MSI with Muelle's own setup window (installer\SetupUI),
  in English or Spanish, chosen from a menu. The same window opens to uninstall from "Installed apps".
  Installing a newer version upgrades the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="Muelle"
          Manufacturer="Gabriel Castiglia"
          Version="$(var.Version)"
          UpgradeCode="7b563c8b-23f7-4432-bb47-5a3534534231"
          IconSourceFile="..\..\src\Muelle\muelle.ico"
          AboutUrl="https://www.gnu.org/licenses/gpl-3.0.html"
          DisableModify="yes">
    <!-- The setup window: a .NET Framework 4.7.2 program, which Windows 10 and 11 already include. -->
    <BootstrapperApplication SourceFile="$(var.SetupUiDir)MuelleSetup.exe">
      <Payload SourceFile="$(var.SetupUiDir)MuelleSetup.exe.config" />
      <Payload SourceFile="$(var.SetupUiDir)WixToolset.BootstrapperApplicationApi.dll" />
      <Payload SourceFile="$(var.SetupUiDir)mbanative.dll" />
    </BootstrapperApplication>

    <!-- Interface language chosen in the setup window; handed to the MSI, which stores it for the dock. -->
    <Variable Name="MuelleLanguage" Value="en" />

    <Chain>
      <MsiPackage Id="MuelleMsi" SourceFile="$(var.MsiPath)">
        <MsiProperty Name="MUELLELANGUAGE" Value="[MuelleLanguage]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
