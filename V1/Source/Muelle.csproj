<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Muelle - Dock for Windows (C# .NET 8 + WPF).
  Copyright (C) 2026 M. Gabriel Castiglia. Created 2026-11-06.
  SPDX-License-Identifier: GPL-3.0-or-later
-->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Muelle</AssemblyName>
    <RootNamespace>Muelle</RootNamespace>
    <StartupObject>Muelle.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>muelle.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>Muelle</Product>
    <Description>Dock para Windows</Description>
    <Version>1.0.0</Version>
    <Authors>M. Gabriel Castiglia</Authors>
    <Company>M. Gabriel Castiglia</Company>
    <Copyright>Copyright (C) 2026 M. Gabriel Castiglia. GPL-3.0-or-later.</Copyright>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- "dotnet publish -c Release" produces a single self-contained Muelle.exe (no .NET install required). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon used by the About window; license shipped next to the executable. -->
    <Resource Include="muelle.ico" />
    <None Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
