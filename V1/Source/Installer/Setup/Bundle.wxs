<!--
  Muelle - Dock for Windows
  Copyright (C) 2026 M. Gabriel Castiglia. Created 2026-11-06.
  SPDX-License-Identifier: GPL-3.0-or-later

  Muelle setup .exe: standard WiX wizard that installs the MSI, links to the GPL v3 license
  and offers to launch Muelle when finished. Installing a newer version upgrades the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Muelle"
          Manufacturer="M. Gabriel Castiglia"
          Version="$(var.Version)"
          UpgradeCode="7b563c8b-23f7-4432-bb47-5a3534534231"
          IconSourceFile="..\..\muelle.ico"
          AboutUrl="https://www.gnu.org/licenses/gpl-3.0.html">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl="https://www.gnu.org/licenses/gpl-3.0.html"
                                              ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- "Launch" button at the end of the wizard. -->
    <Variable Name="LaunchTarget" Value="[ProgramFiles64Folder]Muelle\Muelle.exe" />

    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" />
    </Chain>
  </Bundle>
</Wix>
