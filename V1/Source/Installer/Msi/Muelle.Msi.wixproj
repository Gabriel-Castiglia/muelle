<!-- Muelle MSI installer (WiX Toolset 5). The app must be published first: see Installer\build.ps1. -->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>muelle</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=$(PublishDir);Version=$(Version)</DefineConstants>
    <!-- ICE43/ICE57 assume per-user installs; this package is per-machine (all-users Start menu). -->
    <SuppressIces>ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
