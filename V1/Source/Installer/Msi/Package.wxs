<!--
  Muelle - Dock for Windows
  Copyright (C) 2026 M. Gabriel Castiglia. Created 2026-11-06.
  SPDX-License-Identifier: GPL-3.0-or-later

  MSI package for Muelle.
  - Per-machine install into "Program Files\Muelle" (requires administrator rights).
  - Start menu shortcut and an "Installed apps" entry with its icon.
  - MajorUpgrade: installing a newer version replaces the previous one automatically.
  - Closes a running Muelle before replacing or removing its files.
  User settings (%APPDATA%\Muelle) are never touched, so they survive upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Muelle"
           Manufacturer="M. Gabriel Castiglia"
           Version="$(var.Version)"
           UpgradeCode="e8f73229-40b6-47cb-8384-98997fc792b9"
           Scope="perMachine"
           Language="3082"
           Codepage="1252">
    <SummaryInformation Description="Muelle: dock para Windows" Manufacturer="M. Gabriel Castiglia" />

    <MajorUpgrade DowngradeErrorMessage="Ya está instalada una versión más nueva de Muelle." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="muelle.ico" SourceFile="..\..\muelle.ico" />
    <Property Id="ARPPRODUCTICON" Value="muelle.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Dock para Windows. Licencia GPL-3.0-or-later." />
    <Property Id="ARPURLINFOABOUT" Value="https://www.gnu.org/licenses/gpl-3.0.html" />

    <!-- Close the running dock before its files are replaced or removed. -->
    <util:CloseApplication Id="CloseMuelle" Target="Muelle.exe" CloseMessage="yes" TerminateProcess="0" RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Muelle">
        <Component Id="MuelleExe">
          <File Id="MuelleExe" Source="$(var.PublishDir)Muelle.exe" KeyPath="yes">
            <!-- Start menu shortcut (all users). -->
            <Shortcut Id="MuelleShortcut" Directory="ProgramMenuFolder" Name="Muelle" Description="Dock para Windows"
                      WorkingDirectory="INSTALLFOLDER" Advertise="no" />
          </File>
          <RegistryValue Root="HKLM" Key="Software\Muelle" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
        </Component>
        <Component Id="License">
          <File Id="License" Source="..\..\LICENSE.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Muelle">
      <ComponentRef Id="MuelleExe" />
      <ComponentRef Id="License" />
    </Feature>
  </Package>
</Wix>
